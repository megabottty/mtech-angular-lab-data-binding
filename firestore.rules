rules_version = '2';

// Data model (see src/app/core/services/progress.service.ts — the only
// Firestore collection this app uses): one progress/{uid} doc per student,
// keyed by their own Firebase Auth uid.
//   - A signed-in student may read and write only their own doc.
//   - The teacher (a single fixed uid, same pattern already used client-side
//     in src/app/core/guards/teacher.guard.ts / environment.teacherUid) may
//     read every doc, for the /dashboard page's unfiltered collection query.
//   - Everyone else (including signed-out requests) is denied.
//
// TEACHER_UID must match environment.prod.ts's teacherUid exactly (rules
// can't read the app's environment files, so this value is duplicated here
// on purpose).
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == "7Ppbrl45CFWd8UhDO9cWVlkZFyC2");

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['displayName', 'email', 'completedSteps'])
        && request.resource.data.completedSteps is list;

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
